  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$description": "Famille officielle utilisée par ZIRIS Entreprises et imposée par Russel pour tous les textes visibles du portfolio.",
        "$value": ["DM Sans", "Arial", "sans-serif"]
      },
      "editorial": { "$value": ["DM Sans", "Arial", "sans-serif"] },
      "interface": { "$value": ["DM Sans", "Arial", "sans-serif"] },
      "technical": { "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "editorial": { "$value": 400 },
      "editorial-display": { "$value": 500 },
      "interface-strong": { "$value": 600 },
      "label": { "$value": 600 }
    },
    "size": {
