        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 1,
          "hex": "#ffffff"
        }
      },
      "on-dark-muted": {
        "$type": "color",
        "$description": "Texte secondaire vivant issu de l'aube C3 ; contraste 10,62:1 sur surface/canvas et 9,65:1 sur surface/depth.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.858824, 0.705882, 0.819608],
          "alpha": 1,
          "hex": "#dbb4d1"
        }
      },
      "on-light": {
        "$type": "color",
        "$description": "Encre violette profonde mesurée dans ZIRIS ; contraste 15,43:1 sur blanc et 14,03:1 sur paper-tint.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.152941, 0.094118, 0.34902],
          "alpha": 1,
          "hex": "#271859"
        }
      },
      "on-light-muted": {
        "$type": "color",
        "$description": "Texte secondaire violet issu des glycines C3 ; contraste 9,10:1 sur blanc et 8,28:1 sur paper-tint.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.34902, 0.207843, 0.545098],
          "alpha": 1,
          "hex": "#59358b"
        }
      }
    },
    "violet": {
      "primary": {
        "$type": "color",
        "$description": "Violet principal vivant extrait du lac C3 ; boutons, liens et repères structurants. Contraste 8,70:1 avec le blanc.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.364706, 0.090196, 0.780392],
          "alpha": 1,
          "hex": "#5d17c7"
        }
      },
      "depth": {
        "$type": "color",
