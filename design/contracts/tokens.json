    "proportion": {
      "$type": "number",
      "living-dark-minimum": { "$value": 0.52 },
      "living-dark-maximum": { "$value": 0.72 },
      "light-surface-minimum": { "$value": 0.12 },
      "light-surface-maximum": { "$value": 0.28 },
      "visible-violet-minimum": { "$value": 0.12 },
      "visible-violet-maximum": { "$value": 0.3 },
      "living-green-maximum": { "$value": 0.14 },
      "single-accent-maximum": { "$value": 0.08 },
      "flat-near-black-maximum": { "$value": 0.12 },
      "portrait-minimum": { "$value": 0.35 },
      "portrait-maximum": { "$value": 0.45 },
      "white-opening-maximum": { "$value": 0.24 },
      "white-chapter-maximum": { "$value": 0.3 }
    },
    "reading-measure": {
      "$type": "number",
      "$description": "Target count of characters per line; this is a content measure, not a DTCG dimension.",
      "minimum": { "$value": 45 },
      "maximum": { "$value": 66 }
    },
    "luminance": {
      "$type": "number",
      "light-threshold": { "$value": 0.35 },
      "near-black-threshold": { "$value": 0.05 }
    }
  }
