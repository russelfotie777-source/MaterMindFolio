      },
      "bright": {
        "$type": "color",
        "$description": "Violet franc mesuré dans les références de Russel ; accent court uniquement, jamais halo, grande nappe ou texte courant.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.494118, 0.07451, 0.878431],
          "alpha": 1,
          "hex": "#7e13e0"
        }
      },
      "wisteria": {
        "$type": "color",
        "$description": "Violet floral extrait de l'aube C3, pour détails organiques et graphiques secondaires.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.643137, 0.380392, 0.796078],
          "alpha": 1,
          "hex": "#a461cb"
        }
      }
    },
    "nature": {
      "bamboo": {
        "$type": "color",
        "$description": "Vert profond extrait de la forêt de bambous C3 ; masse végétale et états naturels sombres.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.082353, 0.290196, 0.145098],
          "alpha": 1,
          "hex": "#154a25"
        }
      },
      "living": {
        "$type": "color",
        "$description": "Vert vivant mesuré dans les références de Russel ; accent de progression, focus sombre et détail végétal. Contraste 10,51:1 sur surface/canvas.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.105882, 0.854902, 0.462745],
          "alpha": 1,
          "hex": "#1bda76"
        }
      }
    },
    "solar": {
      "trace": {
        "$type": "color",
        "$description": "Rose sakura demandé par Russel à la place de l'or brun ; trace solaire douce et focus alternatif. Contraste 6,78:1 sur surface/canvas, 6,16:1 sur surface/depth et 5,38:1 avec l'encre violette.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.941176, 0.415686, 0.65098],
          "alpha": 1,
          "hex": "#f06aa6"
        }
      }
    },
    "accent": {
      "magenta": {
        "$type": "color",
        "$description": "Magenta mesuré dans les références de Russel ; micro-accent graphique sur fond sombre, jamais texte courant ni glow.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.843137, 0.156863, 0.74902],
          "alpha": 1,
          "hex": "#d728bf"
        }
      },
      "blue": {
        "$type": "color",
        "$description": "Bleu franc mesuré dans l'interface bancaire de référence ; accent ponctuel, sans dégradé violet-bleu automatique.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.14902, 0.486275, 0.952941],
          "alpha": 1,
          "hex": "#267cf3"
        }
      },
      "coral": {
        "$type": "color",
        "$description": "Corail mesuré dans les références de Russel ; signal rare et non décoratif.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.929412, 0.266667, 0.34902],
          "alpha": 1,
          "hex": "#ed4459"
        }
      }
    },
    "project": {
      "ziris": {
        "$type": "color",
        "$description": "Accent local ZIRIS conservé depuis la capture publique et aligné sur le violet profond C3.",
        "$value": "{color.violet.depth}"
      }
    },
    "state": {
      "focus-on-light": {
        "$type": "color",
        "$description": "Focus sur blanc ou paper-tint ; contraste 8,70:1 sur blanc et 7,92:1 sur paper-tint.",
        "$value": "{color.violet.primary}"
      },
      "focus-on-dark": {
        "$type": "color",
        "$description": "Focus sur noir violet ou profondeur ; contraste 10,51:1 sur surface/canvas et 9,55:1 sur surface/depth.",
        "$value": "{color.nature.living}"
      }
    }
  },
  "space": {
