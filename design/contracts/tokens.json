{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "HORIZON 237 — DR-1 Candidate 3, visual revision C3.2. Structural tokens, living-color palette, organic card geometry and official DM Sans typography. C2 colors and typography are superseded. This file must not be consumed by application code before DR-1 SIGNED and READY FOR CODE.",
  "$extensions": {
    "com.horizon237.release": {
      "version": "DR-1-C3",
      "date": "2026-10-21",
      "status": "candidate-c3-2-sparse-drop-coverage-ready-for-russel-visa",
      "visualRevision": "C3.2 — organic cards, flower-drop used for visual markers and removed from recurrent HORIZON 237 chrome",
      "colorStatus": "c3-rose-trace-requested-by-russel-2026-10-21",
      "typographyStatus": "dm-sans-from-ziris-enterprises-approved-by-russel-2026-10-20",
      "typographyRule": "official-dm-sans-only-for-display-and-interface; no-custom-font; no-redrawn-font; system-monospace-for-code-only",
      "typographySource": "https://ziris-app.alwaysdata.net/vitrine/index",
      "typographyLicense": "SIL Open Font License 1.1",
      "colorRule": "living-natural-color; deep-violet-on-white-or-textured-dark; sakura-rose-instead-of-brown; no-dead-gray; no-glow; light-surfaces-minority",
      "shapeRule": "alternate four asymmetric organic silhouettes; use the handcrafted flower-drop in the matching color wherever a decorative visual marker is needed; keep native dots only for functional pagination; never place the flower beside the recurrent HORIZON 237 label or as an orphan chrome decoration; no recurrent vertical rail; no decorative horizontal divider",
      "supersedes": "DR-1-C2 palette rejected by Russel on 2026-10-20",
      "colorSources": [
        "docs/collecte/COULEURS_REFERENCES_RUSSEL.md",
        "docs/collecte/REVUE_DECOR_CANDIDATS.md",
        "decor-candidats/magnific__equirectangular-360-panorama-21-japanese-dawn-seen__82050.png",
        "decor-candidats/magnific__arashiyama-bamboo-forest-at-deep-blueviolet-dusk-s__8238.png",
        "decor-candidats/magnific__mirrorcalm-japanese-mountain-lake-one-minute-after__8239.png",
        "decor-candidats/magnific__one-single-continuous-photograph-of-a-natural-dark__71840.png"
      ],
      "calibratedColorRoles": [
        "surface/canvas",
        "surface/depth",
        "surface/paper",
        "text/on-dark",
        "text/on-light",
        "violet/primary",
        "nature/living",
        "solar/trace",
        "accent/magenta",
        "accent/blue",
        "project/ziris",
        "state/focus-on-light",
        "state/focus-on-dark"
      ],
      "moodframeSet": "design/releases/DR-1/moodframes-c3/CONTACT-SHEET-C3.webp",
      "readyForCode": false
    }
  },
  "color": {
    "surface": {
      "canvas": {
        "$type": "color",
        "$description": "Fond immersif principal, noir violet vivant mesuré dans le lac C3. La matière ou le grain restent visibles ; jamais un aplat noir mort.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.054902, 0.043137, 0.090196],
          "alpha": 1,
          "hex": "#0e0b17"
        }
      },
      "depth": {
        "$type": "color",
        "$description": "Profondeur violette mesurée dans ZIRIS Entreprises ; alternative vivante au noir pour les grands champs sombres.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.101961, 0.062745, 0.243137],
          "alpha": 1,
          "hex": "#1a103e"
        }
      },
      "elevated": {
        "$type": "color",
        "$description": "Plan sombre surélevé extrait du lac C3 ; les séparations viennent du contraste de valeur, jamais d'un glow.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.145098, 0.098039, 0.341176],
          "alpha": 1,
          "hex": "#251957"
        }
      },
      "basalt": {
        "$type": "color",
        "$description": "Basalte texturé mesuré dans la matière C3, réservé aux pierres et aux plans minéraux.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.196078, 0.192157, 0.192157],
          "alpha": 1,
          "hex": "#323131"
        }
      },
      "paper": {
        "$type": "color",
        "$description": "Blanc pur de référence ZIRIS pour les panneaux nets. Il reste minoritaire dans la composition et ne devient jamais un lavage lumineux.",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 1,
          "hex": "#ffffff"
        }
      },
      "paper-tint": {
        "$type": "color",
        "$description": "Blanc légèrement violet pour distinguer un second niveau clair sans revenir au beige gris de C2.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.968627, 0.94902, 1],
          "alpha": 1,
          "hex": "#f7f2ff"
        }
      }
    },
    "text": {
      "on-dark": {
        "$type": "color",
