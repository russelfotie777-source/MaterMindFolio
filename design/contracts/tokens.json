      "section-mobile": { "$value": { "value": 32, "unit": "px" } },
      "page-mobile": { "$value": { "value": 40, "unit": "px" } },
      "section": { "$value": { "value": 44, "unit": "px" } },
      "display-mobile": { "$value": { "value": 48, "unit": "px" } },
      "page": { "$value": { "value": 64, "unit": "px" } },
      "display": { "$value": { "value": 88, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.96 },
      "page": { "$value": 1 },
      "section": { "$value": 1.08 },
      "project": { "$value": 1.15 },
      "interface": { "$value": 1.25 },
      "proof": { "$value": 1.4 },
      "lead": { "$value": 1.45 },
      "body": { "$value": 1.55 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "focus": { "$value": { "value": 120, "unit": "ms" } },
      "interface": { "$value": { "value": 240, "unit": "ms" } },
      "luminance": { "$value": { "value": 600, "unit": "ms" } },
      "approach": { "$value": { "value": 1500, "unit": "ms" } },
      "chapter-short": { "$value": { "value": 2000, "unit": "ms" } },
      "chapter-long": { "$value": { "value": 2500, "unit": "ms" } },
      "reveal": { "$value": { "value": 3000, "unit": "ms" } },
      "audio-bed-fade": { "$value": { "value": 180, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "interface": { "$value": [0.2, 0, 0, 1] },
      "luminance": { "$value": [0.16, 1, 0.3, 1] },
      "travel": { "$value": [0.65, 0, 0.35, 1] },
      "reveal": { "$value": [0.45, 0, 0.2, 1] }
    }
  },
  "composition": {
    "columns": {
