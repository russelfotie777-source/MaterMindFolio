    "mobile-main": { "$value": { "value": 390, "unit": "px" } },
    "tablet": { "$value": { "value": 768, "unit": "px" } },
    "desktop-compact": { "$value": { "value": 1280, "unit": "px" } },
    "desktop-main": { "$value": { "value": 1440, "unit": "px" } }
  },
