{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "HORIZON 237 — DR-1 Candidate 0. Structural tokens only. Color and material values are deliberately absent until Russel supplies calibrated, rights-cleared source photographs. This file must not be consumed by application code before DR-1 SIGNED and READY FOR CODE.",
  "$extensions": {
    "com.horizon237.release": {
      "version": "DR-1-C0",
      "date": "2026-10-19",
      "status": "blocked-source",
      "colorStatus": "withheld-pending-calibrated-assets",
      "pendingColorRoles": [
        "surface/mineral",
        "text/ink",
        "sky/cobalt",
        "earth/laterite",
        "solar/warm",
        "project/accent",
        "state/focus"
      ],
      "readyForCode": false
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } },
    "32": { "$value": { "value": 128, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "comfort": { "$value": { "value": 2, "unit": "px" } },
    "maximum": { "$value": { "value": 4, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "target-minimum": { "$value": { "value": 44, "unit": "px" } },
    "focus-width": { "$value": { "value": 3, "unit": "px" } },
    "content-desktop": { "$value": { "value": 1312, "unit": "px" } },
    "content-wide-maximum": { "$value": { "value": 1600, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "minimum": { "$value": { "value": 320, "unit": "px" } },
    "mobile-main": { "$value": { "value": 390, "unit": "px" } },
    "tablet": { "$value": { "value": 768, "unit": "px" } },
    "desktop-compact": { "$value": { "value": 1280, "unit": "px" } },
    "desktop-main": { "$value": { "value": 1440, "unit": "px" } }
  },
  "grid": {
    "desktop": {
      "$type": "dimension",
      "margin": { "$value": { "value": 64, "unit": "px" } },
      "gutter": { "$value": { "value": 24, "unit": "px" } }
    },
    "desktop-compact": {
      "$type": "dimension",
      "margin": { "$value": { "value": 48, "unit": "px" } },
      "gutter": { "$value": { "value": 20, "unit": "px" } }
    },
    "tablet": {
      "$type": "dimension",
      "margin": { "$value": { "value": 32, "unit": "px" } },
      "gutter": { "$value": { "value": 16, "unit": "px" } }
    },
    "mobile-main": {
      "$type": "dimension",
      "margin": { "$value": { "value": 20, "unit": "px" } },
      "gutter": { "$value": { "value": 12, "unit": "px" } }
    },
    "mobile-reference": {
      "$type": "dimension",
      "margin": { "$value": { "value": 16, "unit": "px" } },
      "gutter": { "$value": { "value": 12, "unit": "px" } }
    },
    "mobile-minimum": {
      "$type": "dimension",
      "margin": { "$value": { "value": 16, "unit": "px" } },
      "gutter": { "$value": { "value": 8, "unit": "px" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "editorial": { "$value": ["Literata", "Georgia", "serif"] },
      "interface": { "$value": ["Hanken Grotesk", "Arial", "sans-serif"] },
      "technical": { "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "editorial": { "$value": 500 },
      "editorial-display": { "$value": 520 },
      "interface-strong": { "$value": 600 },
      "label": { "$value": 650 }
    },
    "size": {
      "$type": "dimension",
      "label": { "$value": { "value": 12, "unit": "px" } },
      "proof": { "$value": { "value": 14, "unit": "px" } },
      "interface": { "$value": { "value": 16, "unit": "px" } },
      "body-mobile": { "$value": { "value": 17, "unit": "px" } },
      "body": { "$value": { "value": 18, "unit": "px" } },
      "lead-mobile": { "$value": { "value": 20, "unit": "px" } },
      "lead": { "$value": { "value": 22, "unit": "px" } },
      "project-mobile": { "$value": { "value": 24, "unit": "px" } },
      "project": { "$value": { "value": 28, "unit": "px" } },
      "section-mobile": { "$value": { "value": 32, "unit": "px" } },
      "page-mobile": { "$value": { "value": 40, "unit": "px" } },
      "section": { "$value": { "value": 44, "unit": "px" } },
      "display-mobile": { "$value": { "value": 48, "unit": "px" } },
      "page": { "$value": { "value": 64, "unit": "px" } },
      "display": { "$value": { "value": 88, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.96 },
      "page": { "$value": 1 },
      "section": { "$value": 1.08 },
      "project": { "$value": 1.15 },
      "interface": { "$value": 1.25 },
      "proof": { "$value": 1.4 },
      "lead": { "$value": 1.45 },
      "body": { "$value": 1.55 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "focus": { "$value": { "value": 120, "unit": "ms" } },
      "interface": { "$value": { "value": 240, "unit": "ms" } },
      "luminance": { "$value": { "value": 600, "unit": "ms" } },
      "approach": { "$value": { "value": 1500, "unit": "ms" } },
      "chapter-short": { "$value": { "value": 2000, "unit": "ms" } },
      "chapter-long": { "$value": { "value": 2500, "unit": "ms" } },
      "reveal": { "$value": { "value": 3000, "unit": "ms" } },
      "audio-bed-fade": { "$value": { "value": 180, "unit": "ms" } },
      "audio-voice-ramp": { "$value": { "value": 12, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "interface": { "$value": [0.2, 0, 0, 1] },
      "luminance": { "$value": [0.16, 1, 0.3, 1] },
      "travel": { "$value": [0.65, 0, 0.35, 1] },
      "reveal": { "$value": [0.45, 0, 0.2, 1] }
    }
  },
  "composition": {
    "columns": {
      "$type": "number",
      "desktop": { "$value": 12 },
      "tablet": { "$value": 8 },
      "mobile": { "$value": 4 }
    },
    "proportion": {
      "$type": "number",
      "mineral": { "$value": 0.72 },
      "ink-cobalt": { "$value": 0.18 },
      "laterite": { "$value": 0.08 },
      "project-accent-maximum": { "$value": 0.02 },
      "portrait-minimum": { "$value": 0.35 },
      "portrait-maximum": { "$value": 0.45 },
      "light-surface-minimum": { "$value": 0.6 },
      "near-black-opening-maximum": { "$value": 0.25 },
      "near-black-chapter-maximum": { "$value": 0.35 }
    },
    "reading-measure": {
      "$type": "number",
      "$description": "Target count of characters per line; this is a content measure, not a DTCG dimension.",
      "minimum": { "$value": 45 },
      "maximum": { "$value": 66 }
    },
    "luminance": {
      "$type": "number",
      "light-threshold": { "$value": 0.35 },
      "near-black-threshold": { "$value": 0.05 }
    }
  }
}
