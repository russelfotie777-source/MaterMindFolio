      "value": [
        {
          "title": "API et front séparés",
          "rationale": "Le contrat d'API est la seule frontière : chaque côté avance sans bloquer l'autre."
        },
        {
          "title": "Le paiement est la seule source des contreparties",
          "rationale": "Aucune voix ni aucun billet sans paiement abouti ; le prix est toujours calculé par le serveur."
        },
        {
          "title": "Pas de blocage automatique par adresse IP",
          "rationale": "Au Cameroun, une connexion partagée peut regrouper des centaines de votants légitimes ; l'organisation tranche les cas suspects."
        }
      ],
